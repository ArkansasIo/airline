# =====================================================================
# Airport Control - Settings
# (overrides config/config.json when present)
# =====================================================================

# --- Database ---
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=airport_control
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- API ---
API_BASE_URL=http://localhost:8080/api/v1
API_HOST=0.0.0.0
API_PORT=8080
API_MAX_RETRIES=3
API_TIMEOUT_MS=5000
API_CORS_ENABLED=true

# --- Seat assignment ---
SEATS_DEFAULT_TOTAL=150
SEATS_MAX_PER_PASSENGER=4

# --- Dataset / file storage ---
DATASET_PATH=database/dataset.sql
AIRLINE_FILE=airline.txt
SAVE_ON_EXIT=true

# --- Logging ---
LOG_LEVEL=info
LOG_FILE=logs/airport.log
